# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CARTO BASEMAPS (Public client configuration)
NEXT_PUBLIC_CARTO_API_KEY=""
NEXT_PUBLIC_CARTO_BASEMAP_STYLE="voyager"

# Database & Persistence (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host:5432/dbname"
PERSISTENCE_PROVIDER="postgres"

# Customer Authentication & 2Factor OTP
CUSTOMER_AUTH_SECRET=""
TWOFACTOR_API_KEY=""
TWOFACTOR_OTP_TEMPLATE="Greathomes"
TWOFACTOR_OTP_LENGTH="4"

# Staff & Admin Authentication
GH_STAFF_SESSION_SECRET=""

# Cloudflare R2 / S3-Compatible Storage Configuration
STORAGE_PROVIDER="s3"
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="greathomes-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_BASE_URL="https://media.greathomes.co.in"

# Road-Routing Provider Configuration (Server-Side Only — Never prefix keys with NEXT_PUBLIC_)
# Allowed values: "none" | "openrouteservice" | "osrm" | "google_routes"
ROAD_ROUTING_PROVIDER="openrouteservice"
OPENROUTESERVICE_API_KEY=""
OPENROUTESERVICE_BASE_URL="https://api.heigit.org"
OSRM_BASE_URL=""
GOOGLE_ROUTES_API_KEY=""
ROAD_ROUTING_TIMEOUT_MS="2000"
# Cache TTL in seconds (default 86400 = 24h, clamped to provider max permitted TTL)
ROAD_ROUTING_CACHE_TTL="86400"
ROAD_ROUTING_CACHE_TTL_SECONDS="86400"
ROAD_ROUTING_DAILY_BUDGET="1500"

